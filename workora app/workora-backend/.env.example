# --- Database ---
# Local dev (SQLite, zero setup):
DATABASE_URL="file:./dev.db"
# Production (Postgres) example:
# DATABASE_URL="postgresql://user:password@host:5432/workora"

# --- Auth ---
JWT_ACCESS_SECRET="change-this-to-a-long-random-string"
JWT_REFRESH_SECRET="change-this-to-a-different-long-random-string"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30

# --- Google Sign-In ---
# Create an OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
# Web application type. Add your frontend origin under Authorized JavaScript origins.
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# --- Server ---
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# --- Optional: reverse geocoding (city/area from lat/lng) ---
# Without this key, WORKORA still stores lat/lng and lets users type their city manually.
# Any provider works (Google Geocoding, OpenCage, Mapbox) — wire your choice into
# src/lib/geocode.js.
GEOCODING_API_KEY=""
